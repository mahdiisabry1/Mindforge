{
  "name": "LeaderboardEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "weekly_xp": {
      "type": "number",
      "default": 0
    },
    "rank_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "diamond"
      ],
      "default": "bronze"
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "languages_learning": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "avatar_color": {
      "type": "string",
      "default": "#6C63FF"
    }
  },
  "required": [
    "user_id",
    "user_name"
  ]
}