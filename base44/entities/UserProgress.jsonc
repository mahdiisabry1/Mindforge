{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "language_id": {
      "type": "string"
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "current_unit": {
      "type": "number",
      "default": 1
    },
    "current_lesson": {
      "type": "number",
      "default": 1
    },
    "completed_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_practice_date": {
      "type": "string",
      "format": "date"
    },
    "hearts": {
      "type": "number",
      "default": 5
    },
    "level": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "user_id",
    "language_id"
  ]
}