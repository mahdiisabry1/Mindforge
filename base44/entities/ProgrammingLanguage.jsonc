{
  "name": "ProgrammingLanguage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the programming language"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon identifier"
    },
    "color": {
      "type": "string",
      "description": "Brand color hex code"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "description": {
      "type": "string"
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ]
}